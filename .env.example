# 本文件不由程序自动加载。按需复制为 .env 后由终端显式导入。
# 先生成随机 token：python -c 'import secrets; print(secrets.token_urlsafe(32))'
# 把下面的占位符替换为该值，再启动 HTTP 服务。合成 demo 不需要管理 token，但必须能连接 PostgreSQL。
BAEPILOT_API_TOKEN=replace-with-a-random-local-token
BAEPILOT_CONFIG=config.example.toml

# 默认 Fake，无模型网络访问。仅配置 API Key 不会启用真实模型。
# BAEPILOT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=replace-with-your-key
# 数据库必须是 PostgreSQL；示例密码必须替换。推荐终端生成随机十六进制密码。
# BAEPILOT_POSTGRES_PASSWORD=replace-with-a-random-development-password
# BAEPILOT_POSTGRES_PORT=5432
# BAEPILOT_DATABASE_URL=postgresql://baepilot:replace-with-your-password@127.0.0.1:5432/baepilot
# BAEPILOT_DATABASE_SCHEMA=baepilot
# 测试只连接专用合成开发/测试库；每个测试创建并清理独立 schema。
# BAEPILOT_TEST_DATABASE_URL=postgresql://baepilot:replace-with-your-password@127.0.0.1:5432/baepilot
